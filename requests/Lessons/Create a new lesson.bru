meta {
  name: Create a new lesson
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/lessons
  body: json
  auth: inherit
}

body:json {
  {
    "title": "",
    "position": "",
    "content": ""
  }
}

example {
  name: 201 Response
  description: Created
  
  request: {
    url: {{baseUrl}}/api/lessons
    method: POST
    mode: json
    body:json: {
      {
        "title": "",
        "position": "",
        "content": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "",
          "title": "",
          "position": ""
        }
      '''
    }
  }
}
