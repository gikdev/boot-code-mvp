meta {
  name: Change lessons positions
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/lessons/positions
  body: json
  auth: inherit
}

body:json {
  {
    "lessons": [
      {
        "lessonId": "",
        "newPosition": 0
      }
    ]
  }
}

example {
  name: 204 Response
  description: No Content
  
  request: {
    url: {{baseUrl}}/api/lessons/positions
    method: PATCH
    mode: json
    body:json: {
      {
        "lessons": [
          {
            "lessonId": "",
            "newPosition": 0
          }
        ]
      }
    }
  }
  
